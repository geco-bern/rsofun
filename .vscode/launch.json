{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "/Library/Frameworks/R.framework/Resources/bin/exec/R",
      "args": [
        "--vanilla",
        "-e",
        "source('.vscode/debug.R')"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "targetArchitecture": "arm64",
      "environment": [
          {"name":"R_HOME", "value":"/Library/Frameworks/R.framework/Resources"}],
        "setupCommands": [
          {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
          },
          {
          "description": "Set target architecture to aarch64",
          "text": "set architecture aarch64",
          "ignoreFailures": false
          }
        ],
      // "preLaunchTask": "build R pkg (for debugging)"
    },
    {
      "name": "(lldb) Launch R",
      "type": "lldb",
      "request": "launch",
      "program": "/Library/Frameworks/R.framework/Resources/bin/exec/R",
      "args": [
        "--vanilla",
        "-e",
        "source('.vscode/debug.R')"
      ],
      "env": {
        "R_HOME" : "/Library/Frameworks/R.framework/Resources"
      },
      "terminal": "console",
      "stopOnEntry": false
    },
    {
      "name": "(lldb) Attach to R",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickMyProcess}",
      "stopOnEntry": false
    }
  ]
}
