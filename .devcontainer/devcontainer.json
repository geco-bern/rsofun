{
  "name": "R Fortran gdb (perplexity.ai)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "REditorSupport.r",
        "fortran-lang.linter-gfortran"
      ]
    }
  },
  "remoteUser": "root"
}